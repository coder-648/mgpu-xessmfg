lock_frame/lock_frame_ui_*.txt
lock_frame/lock_frame_ui.log
lock_frame/diagnostics_*.zip
diagnostics_*/
diagnostics_*.zip

# 配置/部署备份
*.bak_*
*.before_*
*.pre_*


