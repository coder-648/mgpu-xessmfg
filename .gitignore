# 探测/构建的临时输出（PLAN 补充 1：命令输出重定向到这里再读文件）
temp/

# 构建产物
build/
out/
*.obj
*.pdb
*.ilk
*.addon64
*.exe

# 第三方依赖整体不入库（按 NOTICE / docs/ops/DEPENDENCIES.md 获取）
# 开头的 / 只匹配仓库根目录；lock_frame/third_party/ 下的 vendored
# nlohmann/json 仍然会被跟踪。
/third_party/

# Python
__pycache__/
*.pyc

# 日志（bridge 的重定向输出，历史上都堆在 bin/ 里）
*.log
bridge_*.txt

# Windows 侧产生的中间文件
*.bak
Thumbs.db
desktop.ini

# 部署包产物（make_addon_package.sh 生成，含第三方二进制）
dist/

