// ============================================================================
//  lock_frame module: 025_input_quirks.inc
//
//  OptiScaler's per-game table (misc/GameConfigs.cpp), ported as DATA:
//  modules/input_quirks_data.h is generated by scripts/gen_input_quirks.py and
//  carries every row that declares `.ueExes` or mentions an FG-input setting or
//  quirk (49 of 99). The rest of OptiScaler's ~100 entries are DXGI spoofing /
//  FSR plumbing that our architecture does not need.
//
//  Mapping (see describe()):
//    ForceUnrealEngine            -> --fg-far-finite 75000 (far infinite only)
//    ForceFGRenderSizeMVs         -> our --upsample (already the default)
//    IgnoreValidUntilEvaluateForFG-> producer already ignores lc=2 tags
//    IgnoreTagsWithoutHudlessForFG-> WGC colour path is immune
//    ForceDepthD32S8              -> depth stream accepts D32/R32
//    XeFGCameraMotionFill         -> NOT implemented (needs RGBA velocity/mask)
//    CyberpunkHudlessState        -> FSR-FG only, no XeFG effect
//    FGXeFGJitteredMV = true      -> g_fg_jittered_mv (unless CLI forced it)
//    FGXeFGDepthInverted = true   -> g_fg_depth_inv
//    FGDisableHUDFix / FGPreserveSwapChain / FGSkipResizeBuffers /
//    FGXeFGForceBorderless        -> already our behaviour (info only)
//
//  Modes (--game-quirks): log (default, print only) | apply | off.
//  CLI switches always win: apply never overrides an explicit flag.
// ============================================================================
#pragma once

#include "input_quirks_data.h"

enum InputQuirkMode
{
    QUIRK_OFF = 0,
    QUIRK_LOG = 1,
    QUIRK_APPLY = 2,
};

static int  g_input_quirk_mode = QUIRK_APPLY;   // default on (log-only is --game-quirks log)
static bool g_list_quirks = false;

namespace input_quirks {

inline bool has(const char* haystack, const char* needle)
{
    return haystack != nullptr && needle != nullptr && std::strstr(haystack, needle) != nullptr;
}

inline std::string lower(std::string s)
{
    for (char& c : s) { if (c >= 'A' && c <= 'Z') { c = static_cast<char>(c - 'A' + 'a'); } }
    return s;
}

// "a.exe, b.exe": exact match against the game's exe name (lowercase).
inline bool list_has(const char* list, const std::string& want)
{
    if (list == nullptr || *list == '\0') { return false; }
    std::string l = lower(list);
    size_t pos = 0;
    while (pos <= l.size()) {
        const size_t comma = l.find(',', pos);
        std::string item = l.substr(pos, (comma == std::string::npos) ? std::string::npos : comma - pos);
        while (!item.empty() && item.front() == ' ') { item.erase(item.begin()); }
        while (!item.empty() && item.back() == ' ') { item.pop_back(); }
        if (!item.empty() && item == want) { return true; }
        if (comma == std::string::npos) { break; }
        pos = comma + 1;
    }
    return false;
}

// UE project prefixes: "<project>-win64-shipping.exe" / "-wingdk-shipping.exe".
inline bool ue_matches(const char* list, const std::string& exe)
{
    if (list == nullptr || *list == '\0') { return false; }
    std::string l = lower(list);
    size_t pos = 0;
    while (pos <= l.size()) {
        const size_t comma = l.find(',', pos);
        std::string item = l.substr(pos, (comma == std::string::npos) ? std::string::npos : comma - pos);
        while (!item.empty() && item.front() == ' ') { item.erase(item.begin()); }
        while (!item.empty() && item.back() == ' ') { item.pop_back(); }
        if (!item.empty() && exe.compare(0, item.size(), item) == 0) { return true; }
        if (comma == std::string::npos) { break; }
        pos = comma + 1;
    }
    return false;
}

// Compact one-line description of what a row means for us.
inline std::string describe(const OptiGameRow& r)
{
    std::string out;
    auto add = [&out](const char* s) { if (!out.empty()) { out += "; "; } out += s; };
    if (has(r.quirks, "ForceUnrealEngine"))             { add("UE far plane (apply --fg-far-finite 75000)"); }
    if (has(r.quirks, "ForceFGRenderSizeMVs"))          { add("render-size MVs (--upsample, default)"); }
    if (has(r.quirks, "IgnoreValidUntilEvaluateForFG")) { add("lc=2 tags ignored (producer already)"); }
    if (has(r.quirks, "IgnoreTagsWithoutHudlessForFG")) { add("Unity flipped tags (WGC path immune)"); }
    if (has(r.quirks, "ForceDepthD32S8"))               { add("D32 depth (supported)"); }
    if (has(r.quirks, "XeFGCameraMotionFill"))          { add("NOT PORTED: camera-motion fill"); }
    if (has(r.quirks, "CyberpunkHudlessState"))         { add("FSR-FG hudless only (no XeFG effect)"); }
    if (has(r.defaults, "FGXeFGJitteredMV = true"))     { add("jittered MV (apply)"); }
    if (has(r.defaults, "FGXeFGDepthInverted = true"))  { add("inverted depth (apply)"); }
    if (has(r.defaults, "FGDisableHUDFix"))             { add("no HUD fix (we do not tag UI)"); }
    if (has(r.defaults, "FGPreserveSwapChain"))         { add("preserve chain (we do)"); }
    if (has(r.defaults, "FGSkipResizeBuffers"))         { add("skip resize (we pause)"); }
    if (has(r.defaults, "FGXeFGForceBorderless"))       { add("borderless (we force it)"); }
    if (has(r.defaults, "ReprojectionDepthCutoff"))     { add("reprojection depth cutoff (info: their reprojection path)"); }
    if (out.empty()) { out = "no FG-input effect for us"; }
    return out;
}

} // namespace input_quirks

static void print_input_quirks()
{
    using namespace input_quirks;
    logf_("[lock] input quirks: %u rows ported from OptiScaler (misc/GameConfigs.cpp)\n",
          kOptiGameRowCount);
    for (unsigned i = 0; i < kOptiGameRowCount; ++i) {
        const OptiGameRow& r = kOptiGameRows[i];
        if (r.exes != nullptr && *r.exes != '\0') {
            logf_("[lock]   %s\n", r.exes);
        } else {
            logf_("[lock]   ue:%s\n", r.ue_exes);
        }
        logf_("[lock]     -> %s\n", describe(r).c_str());
        if (r.quirks != nullptr && *r.quirks != '\0') {
            logf_("[lock]     quirks: %s\n", r.quirks);
        }
    }
}

// Called from main() after --game/--game-quirks were parsed and before the
// adapter/device are created, so switches set here reach the init flags.
static void apply_input_quirks()
{
    using namespace input_quirks;
    if (g_input_quirk_mode == QUIRK_OFF || g_game_exe.empty()) { return; }

    const std::string exe = lower(std::string(g_game_exe.begin(), g_game_exe.end()));
    bool matched = false;

    for (unsigned i = 0; i < kOptiGameRowCount; ++i) {
        const OptiGameRow& r = kOptiGameRows[i];
        if (!list_has(r.exes, exe) && !ue_matches(r.ue_exes, exe)) { continue; }
        matched = true;

        const bool ue_row = has(r.quirks, "ForceUnrealEngine") || ue_matches(r.ue_exes, exe);
        logf_("[lock] input quirks: %s%s\n",
              (r.exes != nullptr && *r.exes != '\0') ? r.exes : "ue:",
              (r.exes != nullptr && *r.exes != '\0') ? "" : r.ue_exes);
        if (r.quirks != nullptr && *r.quirks != '\0')     { logf_("[lock]   quirks  : %s\n", r.quirks); }
        if (r.defaults != nullptr && *r.defaults != '\0') { logf_("[lock]   defaults: %s\n", r.defaults); }
        logf_("[lock]   ours    : %s\n", describe(r).c_str());

        if (g_input_quirk_mode != QUIRK_APPLY) { continue; }

        // 1) UE titles with an infinite far plane get the finite 75000 OptiScaler uses.
        if (ue_row && g_fg_far_finite == 0.0f) {
            g_fg_far_finite = 75000.0f;
            logf_("[lock]   applied: --fg-far-finite 75000 (Unreal far plane)\n");
        }
        // 2) Explicit FG init flags from the table (CLI wins).
        if (!g_fg_jittered_mv_forced && !g_fg_jittered_mv &&
            has(r.defaults, "FGXeFGJitteredMV = true")) {
            g_fg_jittered_mv = true;
            logf_("[lock]   applied: jittered MV (FGXeFGJitteredMV)\n");
        }
        if (!g_fg_depth_inv && has(r.defaults, "FGXeFGDepthInverted = true")) {
            g_fg_depth_inv = true;
            logf_("[lock]   applied: inverted depth (FGXeFGDepthInverted)\n");
        }
    }

    if (!matched) {
        logf_("[lock] input quirks: %s has no FG-input row - defaults only\n",
              g_game_exe.c_str());
    }
}
