#include <windows.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION LOCK_FRAME_VERSION_MAJOR, LOCK_FRAME_VERSION_MINOR, LOCK_FRAME_VERSION_PATCH, 0
 PRODUCTVERSION LOCK_FRAME_VERSION_MAJOR, LOCK_FRAME_VERSION_MINOR, LOCK_FRAME_VERSION_PATCH, 0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "mgpu"
            VALUE "FileDescription", "lock_frame consumer"
            VALUE "FileVersion", LOCK_FRAME_VERSION_STRING
            VALUE "InternalName", "lock_frame"
            VALUE "OriginalFilename", "lock_frame.exe"
            VALUE "ProductName", "lock_frame"
            VALUE "ProductVersion", LOCK_FRAME_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
